.{
    // environment variables
    // used by processes spawned by kwm
    .env = .{
        // .{ "key", "value" },
    },

    // working direction of processes spawned by kwm
    .working_directory = .home,

    .startup_cmds = .{
        // .{ "swaybg", "-i", "/path/to/wallpaper" },
    },

    // null
    // or
    // .{ .name = []const u8, .size = u32 }
    .xcursor_theme = null,

    // ?u32
    // solid color background
    // note: set this to null if you use other wallpaper program like `swaybg`, orelse it will be covered by this and unable to see
    .background = 0x33000000,

    .bar = .{
        .show_default = true,
        // .top
        // .bottom
        .position = .top,

        .font = "monospace:size=10",

        .scheme = .{
            .normal = .{
                .fg = 0x828bb8ff,
                .bg = 0x1b1d2bd0,
            },
            .select = .{
                .fg = 0x444a73ff,
                .bg = 0xc8d3f5d0,
            },
        },

        // set null to disable tags part
        .tags = .{
            // tags show on bar
            .tags = .{ "1", "2", "3", "4", "5", "6", "7", "8", "9" },

            // click callback
            // each part supports left/right/middle/side/extra/forward/back/task
            // set null to disable
            .click = .{
                // could use 0 there because it will be replace with the tag clicked
                .left = .{ .set_output_tag = .{ .tag = .{ .tag = 0 } } },
                .right = .{ .toggle_output_tag = .{ .mask = 0 } },
                .middle = .{ .toggle_window_tag = .{ .mask = 0 } },
            },
        },
        // set null to disable mode part
        .mode = .{
            // mode tags show on bar
            // display full mode string by default
            .tags = .{
                .{ "default", "" },         // hide mode tag in default mode
                .{ "passthrough", "P" },    // only show "P" on bar in passthrough mode
                .{ "floating", "F" },       // only show "F" on bar in floating mode
            },

            .click = .{
                .left = .{ .switch_mode = .{ .mode = "default" } },
            },
        },
        // set null to disable layout part
        .layout = .{
            // layout tags show on bar
            // {{?}} will be replaced with managed window count, when the count is 0, `?` will be used as replacement.
            // e.g. [{{{=}}], when managed window count > 0, [N] will be showed, else [=] will be showed
            .tags = .{
                .tile = .{
                    .left = "[]=",
                    .right = "=[]",
                    .top = "[^]",
                    .bottom = "[_]",
                },
                .grid = .{
                    .horizontal = "|+|",
                    .vertical = "|||",
                },
                .monocle = "[{{=}}]",
                .deck = .{
                    .left = "[{{D}}]=",
                    .right = "=[{{D}}]",
                    .top = "[{{D}}^]",
                    .bottom = "[{{D}}_]",
                },
                .scroller = "[==]",
                .centered_master = .{
                    .horizontal = "=[]=",
                    .vertical = "=[V]="
                },
                .float = "><>",
            },

            .click = .{
                .left = .switch_to_previous_layout,
            },
        },
        // set null to disable title part
        .title = .{
            .click = .{
                .left = .{ .zoom = .{ .swap = false } },
            },
        },
        // set null to disable status part
        .status = .{
            .data = .{ .text = "^#ff0000ffk^#00ff00ffw^#0000ffffm" }, // .stdin or .{ .fifo = "fifo file path" }, could use ^#RGBA to switch text color, and use ^#! to switch back to default color

            .click = .{
                .middle = .{ .spawn = .{ .argv = .{ "foot" } } },
            },
        },

        // override colors
        .override_colors = .{
            // areas:
            //      .tags
            //      .{ .mode = "floating" or other modes }, null will match all mode
            //      .{ layout = .tile or other layout }, null will match all layouts
            //      .title
            //      .status
            //
            // scheme is a struct, no need to specify all fields:
            //      .{
            //          .normal = .{
            //              .fg = u32,
            //              .bg = u32,
            //          },
            //          .select = .{
            //              .fg = u32,
            //              .bg = u32,
            //          }
            //      }
            //
            // mode, layout and status will only use the `normal` color
            // tags and title will use both `normal` and `select` color
            //

            // set scheme for mode tag
            .{
                .area = .{ .mode = null },
                .scheme = .{
                    .normal = .{
                        .fg = 0x444a73ff,
                        .bg = 0xc8d3f5d0,
                    }
                }
            },
        }
    },

    .single_tagset = false,

    .sloppy_focus = false,

    // .none
    // .on_focus_changed: warp cursor to the center of window focused
    // .on_output_changed: warp cursor to the center of output focused
    .cursor_warp = .none,

    // disable wrap around when iter focus or swap window in scroller layout
    .disable_wrap_around_for_scroller = false,

    // if to remember last floating geometry
    .remember_floating_geometry = false,

    .auto_swallow = true,

    // .top: stack top
    // .bottom: stack bottom
    // .stack_top: for tile and deck layout
    // .above_focused
    // .below_focused
    .default_attach_mode = .{
        .tile = .top,
        .grid = .top,
        .monocle = .top,
        .deck = .stack_top,
        .scroller = .below_focused,
        .centered_master = .top,
        .float = .top,
    },

    // .csd
    // .ssd
    .default_window_decoration = .ssd,

    // window border
    .border = .{
        .width = 5,
        .color = .{
            .focus = 0xffc777ff,
            .unfocus = 0x828bb8ff,
            .swallowing = 0x0830e6ff,
        },
    },

    // .tile
    // .grid
    // .monocle
    // .deck
    // .scroller
    // .centered_master
    // .float
    .default_layout = .tile,
    .layout = .{
        .tile = .{
            .nmaster = 1,
            .mfact = 0.55,
            .inner_gap = 12,
            .outer_gap = 9,

            // .left
            // .right
            // .top
            // .bottom
            .master_location = .left,
        },
        .grid = .{
            .outer_gap = 9,
            .inner_gap = 12,

            // .horizontal
            // .vertical
            .direction = .horizontal,
        },
        .monocle = .{
            .gap = 9,
        },
        .deck = .{
            .nmaster = 1,
            .mfact = 0.55,
            .inner_gap = 12,
            .outer_gap = 9,

            // .left
            // .right
            // .top
            // .bottom
            .master_location = .left,
        },
        .scroller = .{
            .mfact = 0.5,
            .inner_gap = 16,
            .outer_gap = 9,
        },
        .centered_master = .{
            .nmaster = 1,
            .mfact = 0.55,
            .inner_gap = 12,
            .outer_gap = 9,

            // .horizontal
            // .vertical
            .direction = .horizontal,
        },
    },

    // key/pointer bindings
    .bindings = .{
        // repeat info for key repeat event, different with the repeat_info of input device
        .repeat_info = .{
            .rate = 50,
            .delay = 300,
        },

        // list of key bindings
        // full scheme:
        //       mode: string(< 16 bytes)
        //          "default" and "lock" are defined by default
        //          "default" is the default mode, if you not set `mode`, the binding will be seemed as "default" mode
        //          when the session locked, kwm will switch to "lock" mode
        //          you could define any other mode
        //       key: keysym string
        //       mods:
        //          a struct with fields: shift, ctrl, mod1, mod3, mod4, mod5, and all of these fields are `false` by default
        //          set modifiers to .{} means key binding without any modifier
        //       press: null or action, default is null
        //       release: null or action, default is null
        //       repeat: bool, default is false
        //
        // the corrosponding action will only trigger once when key pressed or released
        // the pressed action and released action could define at the same time
        // if `repeat` is true, after the key pressed, the action will repeatly trigger until key released or any another key pressed
        .key = .{
            .{
                .key = "r",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .reload_config,
            },

            // passthrough
            .{
                .key = "Escape",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .switch_mode = .{ .mode = "passthrough" },
                },
            },
            .{
                .mode = "passthrough",
                .key = "Escape",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .switch_mode = .{ .mode = "default" },
                },
            },

            // floating
            .{
                .key = "f",
                .mods = .{ .mod4 = true, .ctrl = true },
                .press = .{
                    .switch_mode = .{ .mode = "floating", .auto_quit = .once_unbound_pressed },
                },
            },
            .{
                .mode = "floating",
                .key = "l",
                .mods = .{ .mod4 = true },
                .press = .{
                    .move = .{ .step = .{ .horizontal = 10 } },
                },
                .repeat = true,
            },
            .{
                .mode = "floating",
                .key = "h",
                .mods = .{ .mod4 = true },
                .press = .{
                    .move = .{ .step = .{ .horizontal = -10 } },
                },
                .repeat = true,
            },
            .{
                .mode = "floating",
                .key = "j",
                .mods = .{ .mod4 = true },
                .press = .{
                    .move = .{ .step = .{ .vertical = 10 } },
                },
                .repeat = true,
            },
            .{
                .mode = "floating",
                .key = "k",
                .mods = .{ .mod4 = true },
                .press = .{
                    .move = .{ .step = .{ .vertical = -10 } },
                },
                .repeat = true,
            },
            .{
                .mode = "floating",
                .key = "l",
                .mods = .{ .mod4 = true, .ctrl = true },
                .press = .{
                    .resize = .{ .step = .{ .horizontal = 10 } },
                },
                .repeat = true,
            },
            .{
                .mode = "floating",
                .key = "h",
                .mods = .{ .mod4 = true, .ctrl = true },
                .press = .{
                    .resize = .{ .step = .{ .horizontal = -10 } },
                },
                .repeat = true,
            },
            .{
                .mode = "floating",
                .key = "j",
                .mods = .{ .mod4 = true, .ctrl = true },
                .press = .{
                    .resize = .{ .step = .{ .vertical = 10 } },
                },
                .repeat = true,
            },
            .{
                .mode = "floating",
                .key = "k",
                .mods = .{ .mod4 = true, .ctrl = true },
                .press = .{
                    .resize = .{ .step = .{ .vertical = -10 } },
                },
                .repeat = true,
            },
            .{
                .mode = "floating",
                .key = "l",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .snap = .{ .edge = .right },
                },
            },
            .{
                .mode = "floating",
                .key = "h",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .snap = .{ .edge = .left },
                },
            },
            .{
                .mode = "floating",
                .key = "j",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .snap = .{ .edge = .bottom },
                },
            },
            .{
                .mode = "floating",
                .key = "k",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .snap = .{ .edge = .top },
                },
            },

            // default
            .{
                .key = "q",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .quit = .{
                        .exit_session = true,
                        // command to run before quit
                        // will quit only when the process exit with zero status
                        // e.g. .{ "sh", "-c", "~/cleanup.sh" }
                        .hook = null,
                    },
                },
            },
            .{
                .key = "c",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .close,
            },
            .{
                .key = "Return",
                .mods = .{ .mod4 = true },
                .press = .{
                    .zoom = .{ .swap = true },
                },
            },
            .{
                .key = "h",
                .mods = .{ .mod4 = true, .ctrl = true },
                .press = .focus_master_return,
            },
            .{
                .key = "l",
                .mods = .{ .mod4 = true, .ctrl = true },
                .press = .focus_master_return,
            },
            .{
                .key = "b",
                .mods = .{ .mod4 = true },
                .press = .toggle_bar,
            },
            .{
                .key = "j",
                .mods = .{ .mod4 = true },
                .press = .{
                    .focus_iter = .{ .direction = .forward },
                },
            },
            .{
                .key = "k",
                .mods = .{ .mod4 = true },
                .press = .{
                    .focus_iter = .{ .direction = .reverse },
                },
            },
            .{
                .key = "j",
                .mods = .{ .mod4 = true, .ctrl = true },
                .press = .{
                    .focus_iter = .{ .direction = .forward, .skip = .floating },
                },
            },
            .{
                .key = "k",
                .mods = .{ .mod4 = true, .ctrl = true },
                .press = .{
                    .focus_iter = .{ .direction = .reverse, .skip = .floating },
                },
            },
            .{
                .key = "j",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .swap = .{ .direction = .forward },
                },
            },
            .{
                .key = "k",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .swap = .{ .direction = .reverse },
                },
            },
            .{
                .key = "period",
                .mods = .{ .mod4 = true },
                .press = .{
                    .focus_output_iter = .{ .direction = .forward },
                },
            },
            .{
                .key = "comma",
                .mods = .{ .mod4 = true },
                .press = .{
                    .focus_output_iter = .{ .direction = .reverse },
                },
            },
            .{
                .key = "period",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .send_to_output = .{ .direction = .forward },
                },
            },
            .{
                .key = "comma",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .send_to_output = .{ .direction = .reverse },
                },
            },
            .{
                .key = "m",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .toggle_fullscreen = .{ .in_window = true },
                },
            },
            .{
                .key = "f",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .toggle_fullscreen = .{ .in_window = false },
                },
            },
            .{
                .key = "e",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .toggle_maximize,
            },
            .{
                .key = "space",
                .mods = .{ .mod4 = true },
                .press = .switch_to_previous_layout,
            },
            .{
                .key = "f",
                .mods = .{ .mod4 = true },
                .press = .toggle_floating,
            },
            .{
                .key = "s",
                .mods = .{ .mod4 = true, .ctrl = true },
                .press = .toggle_sticky,
            },
            .{
                .key = "a",
                .mods = .{ .mod4 = true },
                .press = .toggle_swallow,
            },
            .{
                .key = "f",
                .mods = .{ .mod4 = true, .mod1 = true },
                .press = .{
                    .switch_layout = .{ .layout = .float },
                },
            },
            .{
                .key = "t",
                .mods = .{ .mod4 = true },
                .press = .{
                    .switch_layout = .{ .layout = .tile },
                },
            },
            .{
                .key = "g",
                .mods = .{ .mod4 = true },
                .press = .{
                    .switch_layout = .{ .layout = .grid },
                },
            },
            .{
                .key = "d",
                .mods = .{ .mod4 = true },
                .press = .{
                    .switch_layout = .{ .layout = .deck },
                },
            },
            .{
                .key = "m",
                .mods = .{ .mod4 = true },
                .press = .{
                    .switch_layout = .{ .layout = .monocle },
                },
            },
            .{
                .key = "s",
                .mods = .{ .mod4 = true },
                .press = .{
                    .switch_layout = .{ .layout = .scroller },
                },
            },
            .{
                .key = "u",
                .mods = .{ .mod4 = true },
                .press = .{
                    .switch_layout = .{ .layout = .centered_master },
                },
            },
            .{
                .key = "Tab",
                .mods = .{ .mod4 = true },
                .press = .switch_to_previous_tag,
            },
            .{
                .key = "apostrophe",
                .mods = .{ .mod4 = true },
                .press = .{
                    .set_output_tag = .{ .tag = .{ .occupied = .forward } },
                },
            },
            .{
                .key = "semicolon",
                .mods = .{ .mod4 = true },
                .press = .{
                    .set_output_tag = .{ .tag = .{ .occupied = .reverse } },
                },
            },
            .{
                .key = "apostrophe",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .set_window_tag = .{ .tag = .{ .unoccupied = .forward } },
                },
            },
            .{
                .key = "semicolon",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .set_window_tag = .{ .tag = .{ .unoccupied = .reverse } },
                },
            },

            .{ .key = "1", .mods = .{ .mod4 = true }, .press = .{ .set_output_tag = .{ .tag = .{ .tag = 0b1 } } } },
            .{ .key = "2", .mods = .{ .mod4 = true }, .press = .{ .set_output_tag = .{ .tag = .{ .tag = 0b10 } } } },
            .{ .key = "3", .mods = .{ .mod4 = true }, .press = .{ .set_output_tag = .{ .tag = .{ .tag = 0b100 } } } },
            .{ .key = "4", .mods = .{ .mod4 = true }, .press = .{ .set_output_tag = .{ .tag = .{ .tag = 0b1000 } } } },
            .{ .key = "5", .mods = .{ .mod4 = true }, .press = .{ .set_output_tag = .{ .tag = .{ .tag = 0b10000 } } } },
            .{ .key = "6", .mods = .{ .mod4 = true }, .press = .{ .set_output_tag = .{ .tag = .{ .tag = 0b100000 } } } },
            .{ .key = "7", .mods = .{ .mod4 = true }, .press = .{ .set_output_tag = .{ .tag = .{ .tag = 0b1000000 } } } },
            .{ .key = "8", .mods = .{ .mod4 = true }, .press = .{ .set_output_tag = .{ .tag = .{ .tag = 0b10000000 } } } },
            .{ .key = "9", .mods = .{ .mod4 = true }, .press = .{ .set_output_tag = .{ .tag = .{ .tag = 0b100000000 } } } },
            .{ .key = "0", .mods = .{ .mod4 = true }, .press = .{ .set_output_tag = .{ .tag = .{ .tag = 0b111111111 } } } },

            .{ .key = "1", .mods = .{ .mod4 = true, .ctrl = true }, .press = .{ .toggle_output_tag = .{ .mask = 0b1 } } },
            .{ .key = "2", .mods = .{ .mod4 = true, .ctrl = true }, .press = .{ .toggle_output_tag = .{ .mask = 0b10 } } },
            .{ .key = "3", .mods = .{ .mod4 = true, .ctrl = true }, .press = .{ .toggle_output_tag = .{ .mask = 0b100 } } },
            .{ .key = "4", .mods = .{ .mod4 = true, .ctrl = true }, .press = .{ .toggle_output_tag = .{ .mask = 0b1000 } } },
            .{ .key = "5", .mods = .{ .mod4 = true, .ctrl = true }, .press = .{ .toggle_output_tag = .{ .mask = 0b10000 } } },
            .{ .key = "6", .mods = .{ .mod4 = true, .ctrl = true }, .press = .{ .toggle_output_tag = .{ .mask = 0b100000 } } },
            .{ .key = "7", .mods = .{ .mod4 = true, .ctrl = true }, .press = .{ .toggle_output_tag = .{ .mask = 0b1000000 } } },
            .{ .key = "8", .mods = .{ .mod4 = true, .ctrl = true }, .press = .{ .toggle_output_tag = .{ .mask = 0b10000000 } } },
            .{ .key = "9", .mods = .{ .mod4 = true, .ctrl = true }, .press = .{ .toggle_output_tag = .{ .mask = 0b100000000 } } },

            .{ .key = "1", .mods = .{ .mod4 = true, .shift = true }, .press = .{ .set_window_tag = .{ .tag = .{ .tag = 0b1 } } } },
            .{ .key = "2", .mods = .{ .mod4 = true, .shift = true }, .press = .{ .set_window_tag = .{ .tag = .{ .tag = 0b10 } } } },
            .{ .key = "3", .mods = .{ .mod4 = true, .shift = true }, .press = .{ .set_window_tag = .{ .tag = .{ .tag = 0b100 } } } },
            .{ .key = "4", .mods = .{ .mod4 = true, .shift = true }, .press = .{ .set_window_tag = .{ .tag = .{ .tag = 0b1000 } } } },
            .{ .key = "5", .mods = .{ .mod4 = true, .shift = true }, .press = .{ .set_window_tag = .{ .tag = .{ .tag = 0b10000 } } } },
            .{ .key = "6", .mods = .{ .mod4 = true, .shift = true }, .press = .{ .set_window_tag = .{ .tag = .{ .tag = 0b100000 } } } },
            .{ .key = "7", .mods = .{ .mod4 = true, .shift = true }, .press = .{ .set_window_tag = .{ .tag = .{ .tag = 0b1000000 } } } },
            .{ .key = "8", .mods = .{ .mod4 = true, .shift = true }, .press = .{ .set_window_tag = .{ .tag = .{ .tag = 0b10000000 } } } },
            .{ .key = "9", .mods = .{ .mod4 = true, .shift = true }, .press = .{ .set_window_tag = .{ .tag = .{ .tag = 0b100000000 } } } },
            .{ .key = "0", .mods = .{ .mod4 = true, .shift = true }, .press = .{ .set_window_tag = .{ .tag = .{ .tag = 0b111111111 } } } },

            .{ .key = "1", .mods = .{ .mod4 = true, .ctrl = true, .shift = true }, .press = .{ .toggle_window_tag = .{ .mask = 0b1 } } },
            .{ .key = "2", .mods = .{ .mod4 = true, .ctrl = true, .shift = true }, .press = .{ .toggle_window_tag = .{ .mask = 0b10 } } },
            .{ .key = "3", .mods = .{ .mod4 = true, .ctrl = true, .shift = true }, .press = .{ .toggle_window_tag = .{ .mask = 0b100 } } },
            .{ .key = "4", .mods = .{ .mod4 = true, .ctrl = true, .shift = true }, .press = .{ .toggle_window_tag = .{ .mask = 0b1000 } } },
            .{ .key = "5", .mods = .{ .mod4 = true, .ctrl = true, .shift = true }, .press = .{ .toggle_window_tag = .{ .mask = 0b10000 } } },
            .{ .key = "6", .mods = .{ .mod4 = true, .ctrl = true, .shift = true }, .press = .{ .toggle_window_tag = .{ .mask = 0b100000 } } },
            .{ .key = "7", .mods = .{ .mod4 = true, .ctrl = true, .shift = true }, .press = .{ .toggle_window_tag = .{ .mask = 0b1000000 } } },
            .{ .key = "8", .mods = .{ .mod4 = true, .ctrl = true, .shift = true }, .press = .{ .toggle_window_tag = .{ .mask = 0b10000000 } } },
            .{ .key = "9", .mods = .{ .mod4 = true, .ctrl = true, .shift = true }, .press = .{ .toggle_window_tag = .{ .mask = 0b100000000 } } },

            .{
                .key = "l",
                .mods = .{ .mod4 = true },
                .press = .{
                    .modify_mfact = .{ .change = .{ .step = 0.01 } },
                },
            },
            .{
                .key = "h",
                .mods = .{ .mod4 = true },
                .press = .{
                    .modify_mfact = .{ .change = .{ .step = -0.01 } },
                },
            },
            .{
                .key = "j",
                .mods = .{ .mod4 = true, .mod1 = true },
                .press = .{
                    .modify_master_location = .{ .location = .bottom },
                },
            },
            .{
                .key = "k",
                .mods = .{ .mod4 = true, .mod1 = true },
                .press = .{
                    .modify_master_location = .{ .location = .top },
                },
            },
            .{
                .key = "l",
                .mods = .{ .mod4 = true, .mod1 = true },
                .press = .{
                    .modify_master_location = .{ .location = .right },
                },
            },
            .{
                .key = "h",
                .mods = .{ .mod4 = true, .mod1 = true },
                .press = .{
                    .modify_master_location = .{ .location = .left },
                },
            },
            .{
                .key = "equal",
                .mods = .{ .mod4 = true },
                .press = .{
                    .modify_nmaster = .{ .change = .increase },
                },
            },
            .{
                .key = "minus",
                .mods = .{ .mod4 = true },
                .press = .{
                    .modify_nmaster = .{ .change = .decrease },
                },
            },
            .{
                .key = "equal",
                .mods = .{ .mod4 = true, .mod1 = true },
                .press = .{
                    .modify_gap = .{ .step = 1 },
                },
            },
            .{
                .key = "minus",
                .mods = .{ .mod4 = true, .mod1 = true },
                .press = .{
                    .modify_gap = .{ .step = -1 },
                },
            },
            .{
                .key = "a",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .toggle_auto_swallow,
            },
            .{
                .key = "g",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .toggle_grid_direction,
            },
            .{
                .key = "u",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .toggle_centered_master_direction,
            },

            .{
                .key = "p",
                .mods = .{ .mod4 = true },
                .press = .{
                    .spawn_shell = .{ .cmd = "wmenu-run" },
                },
            },
            .{
                .key = "Return",
                .mods = .{ .mod4 = true, .shift = true },
                .press = .{
                    .spawn = .{ .argv = .{ "foot" } },
                },
            },
        },

        // list of pointer bindings
        // full scheme:
        //       mode: same as key binding
        //       button: pointer button
        //          .left
        //          .right
        //          .middle
        //       mods: same as key binding
        //       press: null or action, default is null
        //       release: null or action, default is null
        //
        // the corrosponding action will only trigger once when pointer button pressed or released
        // the pressed action and released action could define at the same time
        .pointer = .{
            .{
                .mode = "default",
                .button = .left,
                .mods = .{ .mod4 = true },
                .press = .pointer_move,
            },
            .{
                .mode = "default",
                .button = .right,
                .mods = .{ .mod4 = true },
                .press = .pointer_resize,
            },
        },
        // other unmentioned actions:
        //      group: run multiple actions in sequence
        //          .press = .{
        //              .group = .{
        //                  .actions = .{
        //                      action1,
        //                      action2,
        //                      ...
        //                  },
        //              },
        //          },
    },

    // rule part
    //
    // a rule pattern has fields below:
    //      str: pattern string, required
    //      regex: bool, if enable regex
    //      match_null: bool, if match null
    //
    // only the first rule matched will be applied

    // window rules
    // full scheme:
    //      app_id: rule pattern
    //      title: rule pattern
    //
    //      tag: window tag
    //      output: output name pattern, same as rule pattern
    //      floating: bool, if floating
    //      dimension: .{ .width = i32, .height = i32 }, initial dimension
    //      decoration: .csd or .ssd, window decoration
    //      is_terminal: bool, if set true, means the window could be swallowed
    //      disable_swallow: bool, if set true, the window could not swallow any other windows
    //      scroller_mfact: f32, initial mfact of the window for scroller layout
    //      attach_mode: like `default_attach_mode`, change attach_mode for window matched
    .window_rules = .{
        .{ .app_id = .{ .str = "", .match_null = true }, .floating = true },
        .{ .app_id = .{ .str = "zenity" }, .floating = true },
        .{ .app_id = .{ .str = "DesktopEditors" }, .floating = true },
        .{ .app_id = .{ .str = "xdg-desktop-portal-gtk" }, .floating = true },
        .{ .app_id = .{ .str = "chromium" }, .tag = 0b10, .scroller_mfact = 0.9 },
        .{ .app_id = .{ .str = "foot" }, .is_terminal = true, .scroller_mfact = 0.8 },
    },

    // output rules
    // full scheme:
    //      name: rule pattern
    //
    //      presentation_mode: presentation mode, .vsync or .async
    //      layout: same as `layout` before but you only need to specify the values you want to change
    //      default_layout: same as `default_layout` before
    .output_rules = .{
        //
    },
}
